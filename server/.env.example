# ==============================================================================
# SAHAAY Server Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION (No defaults - application will fail to start without these)
# ------------------------------------------------------------------------------

# JWT Authentication Secret
# MUST be set to a secure, random string (minimum 32 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Domains (e.g. Vercel deployment URL)
# Wildcard (*) is rejected in production.
CORS_ORIGIN=https://your-sahaay-frontend.vercel.app

# PostgreSQL Database Connection URL (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://username:password@hostname:5432/sahaay_db?sslmode=require"

# ------------------------------------------------------------------------------
# OPTIONAL SERVICES & PROVIDERS
# ------------------------------------------------------------------------------

# AI Intelligence Service Engine (mock | openai)
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...

# Document Storage Settings
STORAGE_PROVIDER=local
STORAGE_PATH=../storage
MAX_FILE_SIZE_MB=15
