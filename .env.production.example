# ==============================================================================
# SAHAAY — Production Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Security (CRITICAL: Replace with a secure 32+ character random secret)
JWT_SECRET=replace_with_a_secure_random_hex_or_passphrase_for_production
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
# Set to your production frontend URL(s), comma-separated. Use * only for public APIs.
CORS_ORIGIN=https://your-frontend-domain.com

# Database Connection
# SQLite (Local / Single Container with persistent volume):
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (Cloud / Managed DB / Docker Compose):
# DATABASE_URL="postgresql://user:password@hostname:5432/sahaay_db?schema=public"

# AI Integration
AI_PROVIDER=mock
# To enable real OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# File Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15

# Client-side (For separate Frontend deployment on Vercel/Netlify):
# VITE_API_URL=https://your-backend-api-domain.com
