# ==============================================================================
# SAHAAY - Global Environment Configuration Template
# Citizen-First Land Acquisition & Compensation Companion
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION (No defaults - application will fail to start without these)
# ------------------------------------------------------------------------------

# JWT Authentication Secret
# MUST be set to a secure, random string (minimum 32 characters in production)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_32_characters_long

# JWT Token Expiration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Domains
# MUST be explicitly set to your production frontend domain (e.g. https://sahaay.vercel.app)
# Comma-separated list for multiple domains. Wildcard (*) is strictly forbidden in production.
CORS_ORIGIN=https://your-sahaay-frontend.vercel.app

# PostgreSQL Database Connection (Neon, Supabase, Render, or Self-Hosted)
# Example Neon URL: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/sahaay_db?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/sahaay_db?sslmode=require"

# ------------------------------------------------------------------------------
# OPTIONAL SERVICES & PROVIDERS
# ------------------------------------------------------------------------------

# AI Intelligence Service (mock | openai)
AI_PROVIDER=mock
# If using real OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Document Storage Configuration (local | s3)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=15

# Client-Side URL (Set in Vercel environment variables for frontend):
# VITE_API_URL=https://your-sahaay-backend.onrender.com
